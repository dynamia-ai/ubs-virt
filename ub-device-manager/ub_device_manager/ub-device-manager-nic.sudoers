# sudo >= 1.9.10: anchor the entire argument string; do not grant other hinicadm5 commands.
# The service sets a locally administered VF MAC and clears VF MAC/SVLAN on rollback.
ub-device-manager ALL=(root) NOPASSWD: /usr/sbin/hinicadm5 ^vfconfig -i [[:alnum:]_.:-]{1,15} -f [0-9]+ -m 02(:[[:xdigit:]]{2}){5}$
ub-device-manager ALL=(root) NOPASSWD: /usr/sbin/hinicadm5 ^vfconfig -i [[:alnum:]_.:-]{1,15} -f [0-9]+ -c$
